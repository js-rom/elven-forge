{
  "version": 1,
  "$comment": "Artifact-level checks shared by the inception and elaboration flows. Only presence and traceability are encoded here; section names and order remain owned by the schema templates. Consumed by scripts/validate_step.py from F3 onwards.",
  "artifacts": {
    "Vision and Business Case": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Revision History",
            "Introduction",
            "Positioning",
            "Stakeholder Descriptions",
            "Product Overview"
          ],
          "any_of": [
            ["Summary of System Features", "Success Criteria"],
            ["Other Requirements and Constraints", "Constraints"]
          ]
        }
      ]
    },
    "Use Case Model": {
      "checks": [
        { "kind": "headings", "level": 2, "require": ["Use cases"] },
        { "kind": "plantuml", "min": 1 },
        { "kind": "pattern", "regex": "\\]\\(\\.[/]?use-cases/", "min": 1 }
      ]
    },
    "Use Case brief": {
      "checks": [
        { "kind": "headings", "level": 1, "require": [] },
        { "kind": "pattern", "regex": "(?m)^#\\s+\\S", "min": 1 },
        { "kind": "pattern", "regex": "(?m)^\\*\\*[^*]+:\\*\\*", "min": 1 }
      ]
    },
    "Use Case fully dressed": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Goal",
            "Scope",
            "Level",
            "Stakeholders and Interests",
            "Preconditions",
            "Success guarantee",
            "Extensions (or Alternate flows)",
            "Special requirements",
            "Technology and Data Variations List",
            "Frequency of Occurrence",
            "Miscellaneous"
          ],
          "any_of": [["Primary actor", "Priary actor"]]
        },
        { "kind": "pattern", "regex": "(?m)^## Main Success Scenario", "min": 1 }
      ]
    },
    "Requirements Ranking": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": ["Revision History", "Ranking Criteria", "Ranked Candidates", "Selection for Detailed Analysis"]
        },
        { "kind": "trace", "from": "Use Case Model", "to": "Requirements Ranking", "rule": "every ranked candidate exists in the use case model" }
      ]
    },
    "Supplementary Specification": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Revision History",
            "Introduction",
            "Table Conventions",
            "F - Functionality (Cross-Cutting)",
            "U - Usability",
            "R - Reliability",
            "P - Performance",
            "S - Supportability",
            "+ - Constraints and External Factors",
            "Open Issues and Follow-ups"
          ]
        }
      ]
    },
    "Technical Memo": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Revision History",
            "References",
            "Issue",
            "Solution Summary",
            "Factors",
            "Solution",
            "Motivation",
            "Unresolved Issues",
            "Alternatives Considered"
          ]
        }
      ]
    },
    "Glossary": {
      "checks": [
        { "kind": "headings", "level": 3, "require": ["Revision History", "Definitions"] },
        { "kind": "table_columns", "require": ["Term", "Definition and Information"] }
      ]
    },
    "Domain Model": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": ["Sub-domain Diagrams", "Validation Checklist"],
          "any_of": [["General Model", "Conceptual Model"]],
          "optional": ["Workflow Trace", "Trace to Use Cases"]
        },
        { "kind": "plantuml", "min": 1 }
      ]
    },
    "Architectural Analysis": {
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Revision History",
            "References",
            "Scope and Objectives",
            "FURPS+ Factor Tables",
            "Prioritized Factors",
            "Architectural Decisions",
            "Variation Points",
            "Evolution Points",
            "Over-Engineering / Under-Engineering Risks",
            "Unresolved Issues",
            "Decision Hierarchy Applied"
          ]
        }
      ]
    }
  }
}
