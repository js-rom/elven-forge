{
  "$comment": "Validation rules per step. Routing lives in <phase>.checks.json; this file says what a conforming artifact looks like. Checks may reuse an artifact entry from shared.checks.json with {use: <artifact id>}.",
  "version": 1,
  "elaboration": {
    "2": {
      "artifact": "Domain Model",
      "checks": [{ "use": "Domain Model" }]
    },
    "3": {
      "artifact": "System Sequence Diagram",
      "checks": [
        { "kind": "headings", "level": 2, "require": ["Traceability"] },
        { "kind": "plantuml", "min": 1 }
      ]
    },
    "4": {
      "artifact": "Operation Contracts",
      "checks": [
        { "kind": "headings", "level": 2, "require": ["Validation Checklist"] },
        { "kind": "pattern", "regex": "(?m)^## Scenario\\b", "min": 1 },
        { "kind": "pattern", "regex": "(?m)^## Operation Contract:", "min": 1 }
      ]
    },
    "10": {
      "artifact": "Use Case Realization",
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Revision History",
            "Goal",
            "Inputs and References",
            "Scenario Mapping",
            "Scenario Realizations",
            "Consolidated Design Class View (Use Case Level)",
            "Validation Checklist"
          ]
        },
        { "kind": "links" }
      ],
      "rubric": "rubrics/use-case-realization.md"
    },
    "11": {
      "checks": [
        { "kind": "evidence", "regex": "design-consistency.*0\\s*ERROR" }
      ],
      "rubric": "rubrics/logical-view.md"
    },
    "14A": {
      "artifact": "Acceptance Test Plan",
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Scenario List (Agreed Acceptance List — 14A Output)",
            "Invariant Coverage Matrix",
            "Domain Rules Compliance Matrix"
          ]
        },
        {
          "kind": "table_columns",
          "require": ["Scenario ID", "Scope ID", "Feature file", "Planned execution"]
        }
      ]
    },
    "14B": {
      "artifact": "Test Plan",
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": ["Agreed Test List (Step 1 Output)", "Deferred Items", "Traceability"]
        },
        {
          "kind": "table_columns",
          "require": ["Test ID", "Scope IDs", "Status", "Test file", "Evidence"]
        },
        {
          "kind": "table_rows",
          "section": "Agreed Test List (Step 1 Output)",
          "columns": ["Test ID", "Status", "Evidence"],
          "allow_dash": ["Test file", "Scope IDs"]
        },
        {
          "kind": "allowed_values",
          "section": "Agreed Test List (Step 1 Output)",
          "column": "Status",
          "values": ["implemented", "deferred"]
        },
        {
          "kind": "forbid_values",
          "section": "Agreed Test List (Step 1 Output)",
          "column": "Status",
          "values": ["planned", "pending", ""]
        },
        { "kind": "trace", "from": "Iteration Plan", "to": "Test Plan", "strict": false }
      ],
      "rubric": "rubrics/test-plan.md"
    },
    "14C": {
      "artifact": "Acceptance Test Plan",
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": ["Scenario Reconciliation (14C)", "Execution Evidence (14C)"]
        },
        {
          "kind": "table_columns",
          "require": ["Scenario ID", "Feature file", "Executed", "Result"]
        },
        {
          "kind": "forbid_values",
          "section": "Scenario Reconciliation (14C)",
          "column": "Executed",
          "values": ["no", "skip", ""]
        },
        {
          "kind": "forbid_values",
          "section": "Scenario Reconciliation (14C)",
          "column": "Result",
          "values": ["RED", "not run", ""]
        },
        {
          "kind": "reconcile_table",
          "source": { "section": "Scenario List (Agreed Acceptance List — 14A Output)", "column": "Scenario ID" },
          "target": { "section": "Scenario Reconciliation (14C)", "column": "Scenario ID" },
          "direction": "equal"
        }
      ],
      "rubric": "rubrics/acceptance-execution.md"
    },
    "14D": {
      "artifact": "Iteration Verification",
      "checks": [
        {
          "kind": "headings",
          "level": 2,
          "require": [
            "Design Conformance (14D)",
            "Iteration Plan Coverage (14D)",
            "Iteration Exit Criteria (14D)",
            "Build Evidence",
            "Verdict"
          ]
        },
        {
          "kind": "table_columns",
          "require": ["Scope ID", "Implementation", "Test IDs", "Evidence", "Verdict"]
        },
        {
          "kind": "table_rows",
          "section": "Iteration Plan Coverage (14D)",
          "columns": ["Scope ID", "Evidence", "Verdict"],
          "allow_dash": ["Implementation", "Test IDs", "A-IDs"]
        },
        {
          "kind": "allowed_values",
          "section": "Iteration Plan Coverage (14D)",
          "column": "Verdict",
          "values": ["COVERED", "DEFERRED"]
        },
        {
          "kind": "table_rows",
          "section": "Iteration Exit Criteria (14D)",
          "columns": ["Criterion", "Evidence", "Verdict"]
        },
        {
          "kind": "allowed_values",
          "section": "Iteration Exit Criteria (14D)",
          "column": "Verdict",
          "values": ["MET"]
        },
        {
          "kind": "optional_section",
          "heading": "Test Quality (Mutation)",
          "section": "Test Quality (Mutation)",
          "columns": ["Slice", "Score", "Target", "Killed", "Survived", "No coverage", "Trend", "Verdict"],
          "column": "Verdict",
          "values": ["PASS", "IMPROVE", "REINFORCE", "REGRESSION", "BLIND_SPOTS", "CRITICAL", "ACCEPT"]
        },
        {
          "kind": "optional_section",
          "heading": "Code Quality",
          "section": "Code Quality",
          "columns": ["Gate", "Coverage", "Duplication", "Issues", "Critical", "Verdict"],
          "column": "Verdict",
          "values": ["PASS", "IMPROVE", "BLOCK", "REGRESSION", "ACCEPT", "BASELINE"]
        },
        {
          "kind": "row_value",
          "section": "Verdict",
          "key_column": "Check",
          "key_value": "Overall",
          "value_column": "Verdict",
          "equals": "READY"
        },
        {
          "kind": "reconcile_table",
          "source": { "file": "{Iteration Plan}", "section": "Selected Scope Summary", "column": "Scope ID" },
          "target": { "section": "Iteration Plan Coverage (14D)", "column": "Scope ID" },
          "direction": "equal",
          "allow_missing": ["EP-DPIA-01"]
        }
      ],
      "rubric": "rubrics/conformance.md"
    },
    "15": {
      "artifact": "Requirements Ranking",
      "checks": [{ "use": "Requirements Ranking" }]
    }
  },
  "inception": {
    "3": {
      "artifact": "Use Case Model",
      "checks": [{ "use": "Use Case Model" }]
    },
    "4": {
      "artifact": "Use Case Model",
      "checks": [{ "use": "Use Case Model" }]
    },
    "5": {
      "artifact": "Use Case brief",
      "checks": [{ "use": "Use Case brief" }]
    },
    "6": {
      "artifact": "Requirements Ranking",
      "checks": [
        { "use": "Requirements Ranking" },
        { "kind": "trace", "from": "Use Case Model", "to": "Requirements Ranking", "strict": true }
      ],
      "rubric": "rubrics/use-case-model.md"
    },
    "9": {
      "artifact": "Vision and Business Case",
      "checks": [{ "use": "Vision and Business Case" }],
      "rubric": "rubrics/vision.md"
    },
    "10": {
      "checks": [{ "kind": "all_persisted" }]
    },
    "12": {
      "checks": [
        { "kind": "all_persisted" },
        { "kind": "state_field", "field": "status", "equals": "completed" }
      ]
    }
  }
}
